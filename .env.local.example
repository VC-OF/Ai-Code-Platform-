# ---- LLM provider config (server-side only, never exposed to the browser) ----
# Works with any OpenAI-compatible Chat Completions + tool-calling API.
# You can use either LLM_* or OPENAI_* names - both are read (LLM_* wins if both set).

# Local Ollama (OpenAI-compatible endpoint) - e.g. minimax-m3:cloud
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_MODEL=minimax-m3:cloud
# (no API key needed - auto-filled for localhost:11434)

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# Qwen / DashScope
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-coder-plus
# LLM_API_KEY=sk-...

# OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-sonnet
# LLM_API_KEY=sk-or-...

LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Groq-hosted models (llama-3.*, qwen/*, openai/gpt-oss-*)
# GROQ_API_KEY=gsk_...

# Additional OpenAI-compatible providers (use "openrouter:<model>" /
# "together:<model>" syntax in the model picker). Keys can also be added
# in Settings -> Environment Variables (global scope) without a restart.
# OPENROUTER_API_KEY=sk-or-...
# TOGETHER_API_KEY=...

# Fallback chain: models tried in order when the selected one fails
# LLM_FALLBACKS=openrouter:meta-llama/llama-3.3-70b-instruct:free,llama3.1:latest

# Image generation fallback (primary Pollinations needs no key)
# HUGGINGFACE_API_KEY=hf_...

# ---- Platform secrets ----
# Used to encrypt project environment variables at rest (Settings tab).
# Generate one with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Port used for the generated app's dev server (Preview tab)
PREVIEW_PORT=4001

# ---- Optional hardening / integrations ----
# Require a token on every API request (sent as x-api-key header,
# Authorization: Bearer, or an "auth" cookie). Unset = open local dev mode.
# AUTH_TOKEN=

# Run agent/terminal commands in throwaway Docker containers instead of on
# the host (needs Docker running; network disabled except npm installs).
# SANDBOX_MODE=docker
# SANDBOX_IMAGE=node:20

# One-click deploy (or set VERCEL_TOKEN per project in Settings)
# VERCEL_TOKEN=

# Max tokens per model reply (default 16384). Raise it if long files get cut off;
# providers with a lower cap are retried automatically without it.
# LLM_MAX_OUTPUT_TOKENS=16384

# ---- Agent loop limits (per turn) ----
# When either limit is hit the turn ends "paused" and the chat shows Continue.
# AGENT_MAX_STEPS=150
# AGENT_MAX_DURATION_MIN=60
# Sub-agents spawned with spawn_agent (kind "general") get their own budget.
# SUBAGENT_MAX_STEPS=100
# SUBAGENT_MAX_DURATION_MIN=30

# ---- Reasoning / multimodal models ----
# Ask reasoning models to think harder (sent as reasoning_effort; providers
# that reject the field are retried without it). Thinking is shown in the chat.
# LLM_REASONING_EFFORT=medium
# The view_image tool attaches images only to models known to accept them
# (registry + name heuristics). Force it on/off for other models:
# LLM_VISION=1

# ---- Docker sandbox (SANDBOX_MODE=docker) ----
# Image resolution: SANDBOX_IMAGE > open-code-sandbox:1 (if built) > node:20.
# Build the polyglot image (Python + NumPy/SciPy/SymPy/matplotlib/Jupyter,
# Rust, Go, Java, gcc/g++/gfortran, git) with:
#   npm run sandbox:build
# Add Julia / R:
#   docker build --build-arg JULIA_VERSION=1.11.3 --build-arg WITH_R=1 -t open-code-sandbox:1 docker/sandbox
# SANDBOX_IMAGE=open-code-sandbox:1
